/// One row per finding of a rule, per run.
table Fact_Finding

	/// Findings of the best-practice and Kimball checks.
	measure Findings =
			VAR _runs =
			    SELECTCOLUMNS (
			        ADDCOLUMNS ( VALUES ( Dim_Run[Model] ), "@run", CALCULATE ( MAX ( Fact_Object[Key_Run] ), REMOVEFILTERS ( Dim_Object ) ) ),
			        "@run", [@run]
			    )
			RETURN
			    CALCULATE ( COUNTROWS ( Fact_Finding ), TREATAS ( _runs, Dim_Run[Key_Run] ) )
		formatString: #,0

	/// Findings that break the model or a report.
	measure Errors =
			IF (
			    NOT ISBLANK ( [Objects] ),
			    (
			        VAR _runs =
			            SELECTCOLUMNS (
			                ADDCOLUMNS ( VALUES ( Dim_Run[Model] ), "@run", CALCULATE ( MAX ( Fact_Object[Key_Run] ), REMOVEFILTERS ( Dim_Object ) ) ),
			                "@run", [@run]
			            )
			        RETURN
			            CALCULATE ( CALCULATE ( COUNTROWS ( Fact_Finding ), Dim_Rule[Severity] = "Error" ), TREATAS ( _runs, Dim_Run[Key_Run] ) )
			    ) + 0
			)
		formatString: #,0

	/// Findings that are probably wrong or costly.
	measure Warnings =
			IF (
			    NOT ISBLANK ( [Objects] ),
			    (
			        VAR _runs =
			            SELECTCOLUMNS (
			                ADDCOLUMNS ( VALUES ( Dim_Run[Model] ), "@run", CALCULATE ( MAX ( Fact_Object[Key_Run] ), REMOVEFILTERS ( Dim_Object ) ) ),
			                "@run", [@run]
			            )
			        RETURN
			            CALCULATE ( CALCULATE ( COUNTROWS ( Fact_Finding ), Dim_Rule[Severity] = "Warning" ), TREATAS ( _runs, Dim_Run[Key_Run] ) )
			    ) + 0
			)
		formatString: #,0

	/// Findings worth a look.
	measure Notes =
			IF (
			    NOT ISBLANK ( [Objects] ),
			    (
			        VAR _runs =
			            SELECTCOLUMNS (
			                ADDCOLUMNS ( VALUES ( Dim_Run[Model] ), "@run", CALCULATE ( MAX ( Fact_Object[Key_Run] ), REMOVEFILTERS ( Dim_Object ) ) ),
			                "@run", [@run]
			            )
			        RETURN
			            CALCULATE ( CALCULATE ( COUNTROWS ( Fact_Finding ), Dim_Rule[Severity] = "Note" ), TREATAS ( _runs, Dim_Run[Key_Run] ) )
			    ) + 0
			)
		formatString: #,0

	/// The run: one number per export. Relates to Dim_Run.
	column Key_Run
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Run

	/// The day of the run, as yyyymmdd. Relates to Dim_Date.
	column Key_Date
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Date

	/// The object (table, column, measure or function) in this run. Relates to Dim_Object; -1 is the model as a whole.
	column Key_Object
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Object

	/// The rule; the same number in every run. Relates to Dim_Rule.
	column Key_Rule
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Rule

	/// The visual a report design finding is about. Relates to Dim_Visual; -1 for findings that are not about a visual.
	column Key_Visual
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Visual

	/// What the rule found, in words: the reference, relationship or value it is about.
	column Detail
		dataType: string
		summarizeBy: none
		sourceColumn: Detail

	partition Fact_Finding = m
		mode: import
		source =
				let
				    Source = LoadCsv("findings.csv", {"Key_Run", "Key_Date", "Key_Object", "Key_Rule", "Key_Visual", "Detail"}),
				    Keyed = Table.ReplaceValue(Source, null, "-1", Replacer.ReplaceValue, {"Key_Run", "Key_Date", "Key_Object", "Key_Rule", "Key_Visual"}),
				    Picked = Table.SelectColumns(Keyed, {"Key_Run", "Key_Date", "Key_Object", "Key_Rule", "Key_Visual", "Detail"}),
				    Typed = Table.TransformColumnTypes(Picked, {{"Key_Run", Int64.Type}, {"Key_Date", Int64.Type}, {"Key_Object", Int64.Type}, {"Key_Rule", Int64.Type}, {"Key_Visual", Int64.Type}, {"Detail", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
