/// One row per rule of the checks.
table Dim_Rule

	column Key_Rule
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Rule

	column 'Rule id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Rule id

	column Rule
		dataType: string
		summarizeBy: none
		sourceColumn: Rule

	column Group
		dataType: string
		summarizeBy: none
		sourceColumn: Group

	column Severity
		dataType: string
		summarizeBy: none
		sourceColumn: Severity
		sortByColumn: 'Severity order'

	column 'Severity order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Severity order

	column Help
		dataType: string
		summarizeBy: none
		sourceColumn: Help

	partition Dim_Rule = m
		mode: import
		source =
				let
				    Source = LoadCsv("rules.csv"),
				    Picked = Table.SelectColumns(Source, {"Key_Rule", "Rule id", "Rule", "Group", "Severity", "Severity order", "Help"}),
				    Typed = Table.TransformColumnTypes(Picked, {{"Key_Rule", Int64.Type}, {"Rule id", type text}, {"Rule", type text}, {"Group", type text}, {"Severity", type text}, {"Severity order", Int64.Type}, {"Help", type text}}, "en-US"),
				    Once = Table.Distinct(Typed, {"Key_Rule"})
				in
				    Once

	annotation PBI_ResultType = Table
