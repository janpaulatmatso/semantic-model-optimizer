/// One row per visual of a report, per run, plus the row -1 (none) for findings that are not about a visual.
table Dim_Visual

	/// The visual in this run. Relates to Dim_Visual.
	column Key_Visual
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Key_Visual

	/// The report.
	column Report
		dataType: string
		summarizeBy: none
		sourceColumn: Report

	/// The page of the report.
	column Page
		dataType: string
		summarizeBy: none
		sourceColumn: Page

	/// The title of the visual, or its type when it has no title; (whole page) for a finding about a page.
	column Visual
		dataType: string
		summarizeBy: none
		sourceColumn: Visual

	/// The kind of visual, such as tableEx, barChart or slicer.
	column 'Visual type'
		dataType: string
		summarizeBy: none
		sourceColumn: Visual type

	/// The name of the visual in the report definition.
	column 'Visual id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Visual id

	partition Dim_Visual = m
		mode: import
		source =
				let
				    Source = LoadCsv("visuals.csv", {"Key_Visual", "Report", "Page", "Visual", "Visual type", "Visual id"}),
				    Picked = Table.SelectColumns(Source, {"Key_Visual", "Report", "Page", "Visual", "Visual type", "Visual id"}),
				    Typed = Table.TransformColumnTypes(Picked, {{"Key_Visual", Int64.Type}, {"Report", type text}, {"Page", type text}, {"Visual", type text}, {"Visual type", type text}, {"Visual id", type text}}, "en-US"),
				    WithNone = Table.InsertRows(Typed, 0, {[#"Key_Visual" = -1, #"Report" = "(none)", #"Page" = "(none)", #"Visual" = "(none)", #"Visual type" = "", #"Visual id" = ""]})
				in
				    WithNone

	annotation PBI_ResultType = Table
