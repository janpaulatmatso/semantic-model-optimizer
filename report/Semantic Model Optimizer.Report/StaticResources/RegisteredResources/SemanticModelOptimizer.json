{
  "name": "Semantic Model Optimizer",
  "dataColors": [
    "#5DA5DA",
    "#FAA43A",
    "#60BD68",
    "#F17CB0",
    "#B2912F",
    "#B276B2",
    "#DECF3F",
    "#F15854",
    "#4D4D4D"
  ],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#5DA5DA",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#333333"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6B6B6B"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 24,
      "color": "#333333"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "outline": "None"
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontSize": 9
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "gridVerticalWeight": 1,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly",
            "alignment": "Center",
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "outline": "None",
            "stepped": false
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "outline": "None"
          }
        ]
      }
    }
  }
}
